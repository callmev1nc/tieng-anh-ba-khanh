{
  "name": "tieng-anh-ba-khanh",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "powershell -ExecutionPolicy Bypass -File scripts/make-icons.ps1",
    "check": "node scripts/check-lessons.mjs",
    "smoke": "node scripts/check-lessons.mjs && node scripts/smoke.mjs",
    "ci": "node scripts/check-lessons.mjs && npm run build",
    "deploy": "node scripts/check-lessons.mjs && npm run build && vercel deploy --prod --yes"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vercel": "^64.2.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
